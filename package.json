{
  "name": "yami-canvas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": { "node": "~24" },
  "scripts": {
    "dev": "pnpm --filter @yami/canvas dev",
    "dev:storybook": "pnpm --filter @yami/storybook storybook",
    "build": "pnpm check:generated && pnpm check:boundaries && pnpm -r --filter='./packages/*' --filter='./apps/*' run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint apps packages tests tooling --max-warnings 0",
    "test": "pnpm -r --if-present run test",
    "generate": "pnpm generate:tokens && pnpm generate:catalog",
    "generate:tokens": "node tooling/tokens/build.mjs",
    "generate:catalog": "node tooling/catalog/build.mjs",
    "check:generated": "node tooling/tokens/build.mjs --check && node tooling/catalog/build.mjs --check",
    "check:boundaries": "node tooling/migration/check-boundaries.mjs",
    "check:source": "node tooling/migration/verify-source.mjs",
    "check:yami-freeze": "node tooling/migration/verify-source.mjs",
    "check:docgen": "node tooling/storybook/check.mjs",
    "test:storybook": "pnpm --filter @yami/storybook test-storybook",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "changeset": "changeset",
    "changeset:status": "changeset status"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.2",
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.54.0",
    "vitest": "4.1.10"
  }
}
