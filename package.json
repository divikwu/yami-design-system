{
  "name": "yami-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven Yami design system and prototyping platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/divikwu/yami-design-system.git"
  },
  "homepage": "https://yami-design-system.vercel.app",
  "packageManager": "pnpm@11.20.0",
  "engines": { "node": "~24" },
  "scripts": {
    "dev": "pnpm --filter @yami/canvas dev",
    "dev:canvas": "pnpm --filter @yami/canvas dev",
    "dev:docsite": "pnpm --filter @yami/docsite dev",
    "dev:topic-generator": "pnpm dev:topic-generator-stack",
    "dev:topic-generator-web": "pnpm --filter @yami/topic-generator-app dev",
    "dev:topic-generator-agent": "pnpm --filter @yami/topic-generator-agent dev",
    "dev:topic-generator-stack": "TOPIC_GENERATOR_AGENT_ENDPOINT=http://127.0.0.1:4400/product-selection TOPIC_GENERATOR_PAGE_AGENT_ENDPOINT=http://127.0.0.1:4400/topic-page pnpm --parallel --filter @yami/topic-generator-agent --filter @yami/topic-generator-app dev",
    "build:topic-generator": "pnpm --filter @yami/topic-generator-app build",
    "build:docsite": "pnpm --filter @yami/docsite build",
    "topic-generator:analyze": "pnpm --filter @yami/topic-generator analyze",
    "topic-generator:evaluate": "pnpm --filter @yami/topic-generator evaluate",
    "topic-generator:migrate-storage": "node tooling/topic-generator/migrate-storage.mjs",
    "dev:storybook": "pnpm --filter @yami/storybook storybook",
    "refresh:storybook-search-results": "node tooling/storybook/refresh-search-results-fixture.mjs",
    "build": "pnpm check:images && pnpm check:generated && pnpm check:boundaries && pnpm -r --filter='./packages/*' --filter='./apps/*' run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint apps packages tests tooling --max-warnings 0",
    "test": "pnpm -r --if-present run test",
    "test:images:ecommerce-home": "node tooling/performance/ecommerce-home-images.mjs",
    "generate": "pnpm generate:tokens && pnpm generate:catalog && pnpm generate:registry && pnpm generate:migration-map",
    "generate:tokens": "node tooling/tokens/build.mjs",
    "generate:catalog": "node tooling/catalog/build.mjs",
    "generate:registry": "node tooling/registry/build.mjs",
    "generate:migration-map": "node tooling/migration/build-migration-map.mjs",
    "generate:images:ecommerce-home": "node tooling/images/ecommerce-home.mjs",
    "check:images": "node tooling/images/ecommerce-home.mjs --check",
    "check:generated": "node tooling/tokens/build.mjs --check && node tooling/catalog/build.mjs --check && node tooling/registry/build.mjs --check && node tooling/migration/build-migration-map.mjs --check",
    "check:boundaries": "node tooling/migration/check-boundaries.mjs",
    "check:principles-sync": "node packages/design-system/principles/check-sync.ts",
    "check:tokens-in-docs": "node packages/design-system/principles/check-tokens-in-docs.ts",
    "check:components-in-doc": "node packages/design-system/principles/check-components-in-doc.ts",
    "check:source": "node tooling/migration/verify-source.mjs && node tooling/migration/build-migration-map.mjs --check",
    "check:yami-freeze": "node tooling/migration/verify-source.mjs && node tooling/migration/build-migration-map.mjs --check",
    "check:docgen": "node tooling/storybook/check.mjs",
    "capture:host-visual": "node tooling/storybook/capture-host-comparison.mjs",
    "test:storybook": "pnpm --filter @yami/storybook test-storybook",
    "test:a11y": "playwright test --project=a11y",
    "test:e2e": "playwright test --project=e2e",
    "test:docsite": "pnpm --filter @yami/docsite test",
    "test:docsite:e2e": "pnpm --filter @yami/docsite test:e2e",
    "test:docsite:lighthouse": "pnpm --filter @yami/docsite test:lighthouse",
    "test:visual": "PLAYWRIGHT_USE_PRODUCTION=1 playwright test --project=visual",
    "check:docsite-content": "pnpm --filter @yami/docsite check:content",
    "validate": "pnpm lint && pnpm check:docsite-content && pnpm typecheck && pnpm check:principles-sync && pnpm check:tokens-in-docs && pnpm check:components-in-doc && pnpm check:generated && pnpm check:boundaries && pnpm test",
    "changeset": "changeset",
    "changeset:status": "changeset status"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.11"
  }
}
