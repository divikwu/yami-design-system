{
  "name": "@yami/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": "./components/index.ts",
    "./components": "./components/index.ts",
    "./components/*": "./components/*/index.ts",
    "./components/*/fixtures": "./components/*/fixtures.ts",
    "./styles/base.css": "./styles/base.css",
    "./styles/fonts.css": "./styles/fonts.css",
    "./tokens.css": "./generated/tokens.css",
    "./meta": "./design-system.meta.json",
    "./manifest": "./manifest.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": { "@base-ui/react": "1.6.0", "react": "19.2.7", "react-dom": "19.2.7" },
  "devDependencies": { "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "typescript": "5.9.3", "vitest": "4.1.10", "happy-dom": "20.8.3" }
}
