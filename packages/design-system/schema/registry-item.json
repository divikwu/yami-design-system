{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yami.local/schema/registry-item.json",
  "title": "YAMI internal source registry item",
  "oneOf": [
    { "$ref": "#/$defs/designSystemItem" },
    { "$ref": "#/$defs/componentItem" }
  ],
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "common": {
      "type": "object",
      "required": ["$schema", "schemaVersion", "name", "title", "type", "status", "version", "description", "source", "files", "contentDigest"],
      "properties": {
        "$schema": { "const": "../../schema/registry-item.json" },
        "schemaVersion": { "const": 2 },
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "type": { "enum": ["design-system", "component"] },
        "status": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/file" } },
        "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "designSystemItem": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$schema", "schemaVersion", "name", "title", "type", "status", "version", "description", "source", "files", "distribution", "documentation", "contentDigest"],
          "properties": {
            "$schema": true,
            "schemaVersion": true,
            "name": true,
            "title": true,
            "type": { "const": "design-system" },
            "status": true,
            "version": true,
            "description": true,
            "source": true,
            "files": true,
            "distribution": {
              "type": "object",
              "additionalProperties": false,
              "required": ["package", "registry"],
              "properties": {
                "package": { "const": "@yami/design-system" },
                "registry": { "const": "internal-source" }
              }
            },
            "documentation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["spec", "skill", "skillZh"],
              "properties": {
                "spec": { "type": "string" },
                "skill": { "type": "string" },
                "skillZh": { "type": "string" }
              }
            },
            "contentDigest": true
          }
        }
      ]
    },
    "componentItem": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["$schema", "schemaVersion", "name", "title", "type", "status", "version", "description", "source", "files", "exports", "composes", "dependencies", "documentation", "design", "quality", "contentDigest"],
          "properties": {
            "$schema": true,
            "schemaVersion": true,
            "name": true,
            "title": true,
            "type": { "const": "component" },
            "status": { "enum": ["stable", "beta", "experimental"] },
            "version": true,
            "description": true,
            "source": true,
            "files": true,
            "exports": { "$ref": "#/$defs/stringArray" },
            "composes": { "$ref": "#/$defs/stringArray" },
            "dependencies": {
              "type": "object",
              "additionalProperties": false,
              "required": ["runtime", "peer", "devOnly"],
              "properties": {
                "runtime": { "$ref": "#/$defs/stringArray" },
                "peer": { "$ref": "#/$defs/stringArray" },
                "devOnly": { "$ref": "#/$defs/stringArray" }
              }
            },
            "documentation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["usage", "stories", "examples"],
              "properties": {
                "usage": { "type": "string", "minLength": 1 },
                "stories": { "$ref": "#/$defs/stringArray" },
                "examples": { "$ref": "#/$defs/stringArray" }
              }
            },
            "design": {
              "type": "object",
              "additionalProperties": false,
              "required": ["tokens", "rules", "tokenBindings"],
              "properties": {
                "tokens": { "$ref": "#/$defs/stringArray" },
                "rules": { "$ref": "#/$defs/stringArray" },
                "tokenBindings": { "type": "object" }
              }
            },
            "quality": {
              "type": "object",
              "additionalProperties": false,
              "required": ["accessibility", "interactionCoverage"],
              "properties": {
                "accessibility": { "type": "object" },
                "interactionCoverage": { "enum": ["covered", "not-applicable", "missing"] }
              }
            },
            "contentDigest": true
          }
        }
      ]
    }
  }
}
