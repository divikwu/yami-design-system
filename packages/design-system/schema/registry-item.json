{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yami.local/schema/registry-item.json",
  "title": "YAMI internal source registry item",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "title",
    "type",
    "status",
    "version",
    "description",
    "source",
    "files",
    "exports",
    "composes",
    "dependencies",
    "documentation",
    "design",
    "quality",
    "contentDigest"
  ],
  "properties": {
    "$schema": { "const": "../../schema/registry-item.json" },
    "schemaVersion": { "const": 2 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "type": { "enum": ["design-system", "component"] },
    "status": { "enum": ["alpha", "stable", "beta", "experimental"] },
    "version": { "$ref": "#/$defs/semver" },
    "description": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/file" }
    },
    "exports": { "$ref": "#/$defs/stringArray" },
    "composes": { "$ref": "#/$defs/stringArray" },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "peer", "devOnly"],
      "properties": {
        "runtime": { "$ref": "#/$defs/stringArray" },
        "peer": { "$ref": "#/$defs/stringArray" },
        "devOnly": { "$ref": "#/$defs/stringArray" }
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "usage": { "type": "string", "minLength": 1 },
        "stories": { "$ref": "#/$defs/stringArray" },
        "examples": { "$ref": "#/$defs/stringArray" }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "rules"],
      "properties": {
        "tokens": { "$ref": "#/$defs/stringArray" },
        "rules": { "$ref": "#/$defs/stringArray" },
        "tokenBindings": {
          "type": "object",
          "propertyNames": { "pattern": "^--[a-z0-9-]+$" },
          "additionalProperties": { "$ref": "#/$defs/tokenBinding" }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accessibility", "interactionCoverage"],
      "properties": {
        "accessibility": { "type": "object" },
        "interactionCoverage": { "enum": ["covered", "not-applicable", "missing"] }
      }
    },
    "contentDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "tokenBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "selector"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "media": { "type": "string", "minLength": 1 }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
