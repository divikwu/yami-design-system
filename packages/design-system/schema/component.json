{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yami.local/schema/component.json",
  "title": "YAMI component metadata",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "$schema",
    "name",
    "category",
    "status",
    "version",
    "description",
    "figma",
    "props",
    "rules",
    "tokens",
    "accessibility",
    "dependencies",
    "usageRef",
    "examples"
  ],
  "properties": {
    "$schema": { "const": "../../schema/component.json" },
    "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "category": {
      "enum": ["action", "composite", "display", "form", "layout", "navigation"]
    },
    "status": { "enum": ["stable", "beta", "experimental"] },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "figma": { "type": "object" },
    "exports": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "composes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "variants": { "type": "object" },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type", "required"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "required": {
            "anyOf": [
              { "type": "boolean" },
              { "type": "string", "minLength": 1 }
            ]
          },
          "description": { "type": "string" }
        }
      }
    },
    "rules": { "type": "object" },
    "tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^--[a-z0-9-]+$" }
    },
    "tokenBindings": {
      "type": "object",
      "propertyNames": { "pattern": "^--[a-z0-9-]+$" },
      "additionalProperties": { "$ref": "#/$defs/tokenBinding" }
    },
    "accessibility": { "type": "object", "minProperties": 1 },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "peer", "devOnly"],
      "properties": {
        "runtime": { "$ref": "#/$defs/stringArray" },
        "peer": { "$ref": "#/$defs/stringArray" },
        "devOnly": { "$ref": "#/$defs/stringArray" }
      }
    },
    "usageRef": { "const": "./usage.md" },
    "examples": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^\\./[^#]+#[A-Za-z_$][A-Za-z0-9_$]*$" }
    },
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction", "rationale"],
      "properties": {
        "interaction": { "enum": ["covered", "not-applicable"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "tokenBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["property", "selector"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "selector": { "type": "string", "minLength": 1 },
        "media": { "type": "string", "minLength": 1 }
      }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
