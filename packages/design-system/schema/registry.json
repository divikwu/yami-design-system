{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yami.local/schema/registry.json",
  "title": "YAMI internal source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "name", "visibility", "version", "status", "generatedFrom", "distribution", "items"],
  "properties": {
    "$schema": { "const": "../schema/registry.json" },
    "schemaVersion": { "const": 2 },
    "name": { "const": "yami" },
    "visibility": { "const": "private" },
    "version": { "$ref": "#/$defs/semver" },
    "status": { "enum": ["alpha", "stable", "beta", "experimental"] },
    "generatedFrom": { "type": "string", "minLength": 1 },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "registry"],
      "properties": {
        "package": { "const": "@yami/design-system" },
        "registry": { "const": "internal-source" }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "title", "type", "status", "version", "path", "digest"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "type": { "enum": ["design-system", "component"] },
          "status": { "enum": ["alpha", "stable", "beta", "experimental"] },
          "version": { "$ref": "#/$defs/semver" },
          "path": { "type": "string", "pattern": "^registry-items/[a-z0-9-]+\\.json$" },
          "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    }
  }
}
