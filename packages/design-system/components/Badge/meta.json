{
  "$schema": "../../../schema/component.json",
  "name": "Badge",
  "category": "display",
  "status": "stable",
  "version": "0.2.0",

  "description": "Small pill-shaped label for product status, promotion, and counts. Two parallel APIs: (1) abstract color (6) × emphasis (primary solid / secondary tinted); (2) `type` shortcut mapping to Figma's named Type variants (sale / new / hot / discount / etc.). Red reserved for promotion/urgency per design.md.",

  "figma": {
    "fileKey": "6oOAy72DBff4P6NzJYc2hi",
    "nodeId": "1539:22788",
    "componentKey": null,
    "notes": "Primary binding is Badge / PC. Badge height is standardized to 20px across PC and Mobile while preserving the responsive text scale. The 4 specialty sets (Top Seller, Membership tag/icon, Badge icon) are out-of-scope for the abstract Badge — track them as separate components if they ship to product.",
    "nodes": {
      "mobile": "1538:3058",
      "pc": "1539:22788",
      "specialty": {
        "topSeller": "2861:117",
        "membershipTag": "1632:21283",
        "badgeIcon": "2412:33621",
        "membershipIcon": "5960:91035"
      }
    },
    "sizeDelta": "Badge uses a fixed 20px height across breakpoints. Text remains responsive: 12/16 on mobile/tablet and 14/20 at the PC breakpoint (min-width: 1024px)."
  },

  "variants": {
    "color": ["red", "blue", "green", "purple", "yellow", "neutral"],
    "emphasis": ["primary", "secondary"],
    "type": [
      "price",
      "sale",
      "low-price",
      "discount",
      "new",
      "hot",
      "exclusive",
      "choice",
      "best-sellers"
    ]
  },

  "props": {
    "color": {
      "type": "enum",
      "values": ["red", "blue", "green", "purple", "yellow", "neutral"],
      "required": false,
      "default": "neutral",
      "description": "Semantic color. 'red' only for promotion/sale (rule: red-usage)."
    },
    "emphasis": {
      "type": "enum",
      "values": ["primary", "secondary"],
      "required": false,
      "default": "primary",
      "description": "'primary' = solid bg, high contrast. 'secondary' = tinted bg, softer."
    },
    "type": {
      "type": "enum",
      "values": [
        "price",
        "sale",
        "low-price",
        "discount",
        "new",
        "hot",
        "exclusive",
        "choice",
        "best-sellers"
      ],
      "required": false,
      "description": "Semantic shortcut mirroring Figma's Type variant. Resolves to a (color, emphasis) preset (e.g. 'sale' → red+secondary). Explicit color / emphasis props override the preset. 'exclusive' (purple flag) and 'choice' (blue flag) additionally render a flush-left YAMI logo flag prefix matching assets/badges/flag-cap-{purple,blue}.svg."
    },
    "children": {
      "type": "ReactNode",
      "required": false,
      "description": "Label text. Typically 1 word or short phrase (NEW, SALE, –30%, 限时)."
    }
  },

  "rules": {
    "colorUsage": {
      "ruleId": "red-usage",
      "note": "color='red' only for promotion / urgency / sale. Never decorative."
    },
    "semanticColor": {
      "ruleId": "semantic-color-only",
      "note": "The 6-color palette IS the sanctioned non-brand color set — this is the one place blue/green/purple/yellow are OK."
    },
    "noEmoji": {
      "ruleId": "no-emoji",
      "note": "Badge text is plain. Do not encode pictograms as emoji or as ad-hoc Badge variants."
    },
    "numerals": {
      "ruleId": "numerals-font",
      "note": "Digits (–30%, 1.2k, etc.) render in var(--font-family-ios) = GT Walsheim."
    },
    "radii": {
      "ruleId": "no-custom-radii",
      "note": "Uses --radius-tag-primary (4px). Never override."
    }
  },

  "tokens": [
    "--badge-bg-primary-red",
    "--badge-fg-primary-red",
    "--badge-bg-primary-blue",
    "--badge-bg-primary-green",
    "--badge-bg-primary-purple",
    "--badge-bg-primary-yellow",
    "--badge-bg-primary-neutral",
    "--badge-bg-secondary-red",
    "--badge-fg-secondary-red",
    "--badge-bg-secondary-blue",
    "--badge-fg-secondary-blue",
    "--badge-bg-secondary-green",
    "--badge-fg-secondary-green",
    "--badge-bg-secondary-purple",
    "--badge-fg-secondary-purple",
    "--badge-bg-secondary-yellow",
    "--badge-fg-secondary-yellow",
    "--badge-bg-tertiary-neutral",
