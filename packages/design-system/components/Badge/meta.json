  },

  "accessibility": {
    "role": "implicit (span)",
    "wcagLevel": "AA",
    "tapTargetMin": 0,
    "keyboardNav": [],
    "ariaPattern": "label",
    "notes": "Badge is a visual label (non-interactive — tapTargetMin=0). If it conveys state not present in adjacent text (e.g. 'OUT OF STOCK' on an otherwise normal-looking product), ensure the state is also encoded in markup — e.g. aria-label on the parent product element."
  },

