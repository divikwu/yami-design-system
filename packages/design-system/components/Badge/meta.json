{
  "$schema": "../../schema/component.json",
  "name": "Badge",
  "category": "display",
  "status": "stable",
  "version": "0.5.0",

  "description": "Small label for product status, promotion, and counts. Supports sm and md sizes, abstract color × emphasis, four background-polarity tones, and semantic `type` shortcuts matching Figma.",

  "figma": {
    "fileKey": "6oOAy72DBff4P6NzJYc2hi",
    "nodeId": "1539:22788",
    "componentKey": null,
    "notes": "Primary binding is Badge / PC. Both Figma bindings map to the default sm size; md is a code-defined extension. The 4 specialty sets (Top Seller, Membership tag/icon, Badge icon) are out-of-scope for the abstract Badge — track them as separate components if they ship to product.",
    "nodes": {
      "mobile": "1538:3058",
      "pc": "1539:22788",
      "specialty": {
        "topSeller": "2861:117",
        "membershipTag": "1632:21283",
        "badgeIcon": "2412:33621",
        "membershipIcon": "5960:91035"
      }
    },
    "sizeDelta": "Badge sizes are breakpoint-independent: sm is 20px high with 12/16 type; md is 24px high with 14/20 type."
  },

  "exports": [
    "Badge",
    "BadgeColor",
    "BadgeEmphasis",
    "BadgeProps",
    "BadgeSize",
    "BadgeTone",
    "BadgeType"
  ],

  "variants": {
    "color": ["red", "blue", "green", "purple", "yellow", "neutral"],
    "emphasis": ["primary", "secondary"],
    "size": ["sm", "md"],
    "tone": ["dark", "light", "dark-outline", "light-outline"],
    "type": [
      "price",
      "sale",
      "low-price",
      "discount",
      "new",
      "hot",
      "exclusive",
      "choice",
      "best-sellers"
    ]
  },

  "props": {
    "color": {
      "type": "enum",
      "values": ["red", "blue", "green", "purple", "yellow", "neutral"],
      "required": false,
      "default": "neutral",
      "description": "Semantic color. 'red' only for promotion/sale (rule: red-usage)."
    },
    "emphasis": {
      "type": "enum",
      "values": ["primary", "secondary"],
      "required": false,
      "default": "primary",
      "description": "'primary' = solid bg, high contrast. 'secondary' = tinted bg, softer."
    },
    "size": {
      "type": "enum",
      "values": ["sm", "md"],
      "required": false,
      "default": "sm",
      "description": "Breakpoint-independent geometry with 8px horizontal padding. 'sm' = 20px height with 12/16 type; 'md' = 24px height with 14/20 type."
    },
    "tone": {
      "type": "enum",
      "values": ["dark", "light", "dark-outline", "light-outline"],
      "required": false,
      "description": "Optional background-polarity treatment. Filled tones use translucent black or white; outline tones use a transparent fill and 1px inset stroke. Tone takes visual priority without changing Badge size or radius."
    },
    "type": {
      "type": "enum",
      "values": [
        "price",
        "sale",
        "low-price",
        "discount",
        "new",
        "hot",
        "exclusive",
        "choice",
        "best-sellers"
      ],
      "required": false,
      "description": "Semantic shortcut mirroring Figma's Type variant. Resolves to a (color, emphasis) preset (e.g. 'sale' → red+secondary). Explicit color / emphasis props override the preset. 'exclusive' (purple flag) and 'choice' (blue flag) additionally render a flush-left YAMI logo flag prefix matching assets/badges/flag-cap-{purple,blue}.svg."
    },
    "children": {
      "type": "ReactNode",
      "required": false,
      "description": "Label text. Typically 1 word or short phrase (NEW, SALE, –30%, 限时)."
    }
  },

  "rules": {
    "colorUsage": {
      "ruleId": "red-usage",
      "note": "color='red' only for promotion / urgency / sale. Never decorative."
    },
    "semanticColor": {
      "ruleId": "semantic-color-only",
      "note": "The 6-color palette IS the sanctioned non-brand color set — this is the one place blue/green/purple/yellow are OK."
    },
    "noEmoji": {
      "ruleId": "no-emoji",
      "note": "Badge text is plain. Do not encode pictograms as emoji or as ad-hoc Badge variants."
    },
    "numerals": {
      "ruleId": "numerals-font",
      "note": "Digits (–30%, 1.2k, etc.) render in var(--font-family-ios) = GT Walsheim."
    },
    "radii": {
      "ruleId": "no-custom-radii",
      "note": "Uses --radius-tag-primary (4px). Never override."
    },
    "surfaceTone": {
      "ruleId": "semantic-color-only",
      "note": "Use dark tones on light or mixed backgrounds and light tones on dark backgrounds. All four tones retain the selected Badge size and 4px radius."
    }
  },

  "tokens": [
    "--badge-bg-primary-red",
    "--badge-fg-primary-red",
    "--badge-bg-primary-blue",
    "--badge-bg-primary-green",
    "--badge-bg-primary-purple",
    "--badge-bg-primary-yellow",
    "--badge-bg-primary-neutral",
    "--badge-bg-secondary-red",
    "--badge-fg-secondary-red",
    "--badge-bg-secondary-blue",
    "--badge-fg-secondary-blue",
    "--badge-bg-secondary-green",
    "--badge-fg-secondary-green",
    "--badge-bg-secondary-purple",
    "--badge-fg-secondary-purple",
    "--badge-bg-secondary-yellow",
    "--badge-fg-secondary-yellow",
    "--badge-bg-tertiary-neutral",
    "--badge-fg-default",
    "--badge-fg-default-inverse",
    "--color-black-200",
    "--color-black-1000",
    "--color-white-700",
    "--color-white-1000",
    "--text-primary",
    "--font-family-ios",
    "--font-weight-normal",
    "--radius-tag-primary",
    "--space-025",
    "--space-100",
    "--stroke-default"
  ],

  "tokenBindings": {
    "--badge-bg-primary-red": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='primary'][data-color='red']"
    },
    "--badge-fg-primary-red": {
      "property": "color",
      "selector": ".badge[data-emphasis='primary'][data-color='red']"
    },
    "--badge-bg-primary-blue": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='primary'][data-color='blue']"
    },
    "--badge-bg-primary-green": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='primary'][data-color='green']"
    },
    "--badge-bg-primary-purple": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='primary'][data-color='purple']"
    },
    "--badge-bg-primary-yellow": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='primary'][data-color='yellow']"
    },
    "--badge-bg-primary-neutral": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='primary'][data-color='neutral']"
    },
    "--badge-fg-default-inverse": {
      "property": "color",
      "selector": ".badge[data-emphasis='primary']:not([data-color='red'])"
    },
    "--badge-bg-secondary-red": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='secondary'][data-color='red']"
    },
    "--badge-fg-secondary-red": {
      "property": "color",
      "selector": ".badge[data-emphasis='secondary'][data-color='red']"
    },
    "--badge-bg-secondary-blue": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='secondary'][data-color='blue']"
    },
    "--badge-fg-secondary-blue": {
      "property": "color",
      "selector": ".badge[data-emphasis='secondary'][data-color='blue']"
    },
    "--badge-bg-secondary-green": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='secondary'][data-color='green']"
    },
    "--badge-fg-secondary-green": {
      "property": "color",
      "selector": ".badge[data-emphasis='secondary'][data-color='green']"
    },
    "--badge-bg-secondary-purple": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='secondary'][data-color='purple']"
    },
    "--badge-fg-secondary-purple": {
      "property": "color",
      "selector": ".badge[data-emphasis='secondary'][data-color='purple']"
    },
    "--badge-bg-secondary-yellow": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='secondary'][data-color='yellow']"
    },
    "--badge-fg-secondary-yellow": {
      "property": "color",
      "selector": ".badge[data-emphasis='secondary'][data-color='yellow']"
    },
    "--badge-bg-tertiary-neutral": {
      "property": "background-color",
      "selector": ".badge[data-emphasis='secondary'][data-color='neutral']"
    },
    "--badge-fg-default": {
      "property": "color",
      "selector": ".badge[data-emphasis='secondary'][data-color='neutral']"
    },
    "--text-primary": {
      "property": "color",
      "selector": ".badge[data-emphasis='secondary'][data-type='sale'], .badge[data-emphasis='secondary'][data-type='low-price'], .badge[data-emphasis='secondary'][data-type='discount'], .badge[data-emphasis='secondary'][data-type='new'], .badge[data-emphasis='secondary'][data-type='hot']"
    },
    "--font-family-ios": { "property": "font-family", "selector": ".badge" },
    "--font-weight-normal": { "property": "font-weight", "selector": ".badge" },
    "--radius-tag-primary": {
      "property": "border-radius",
      "selector": ".badge"
    },
    "--space-025": { "property": "gap", "selector": ".badge" },
    "--space-100": {
      "property": "padding-inline",
      "selector": ".badge"
    },
    "--color-black-200": {
      "property": "background-color",
      "selector": ".badge[data-tone='dark']"
    },
    "--color-white-700": {
      "property": "background-color",
      "selector": ".badge[data-tone='light']"
    },
    "--color-black-1000": {
      "property": "color / box-shadow",
      "selector": ".badge[data-tone='light'], .badge[data-tone='dark-outline']"
    },
    "--color-white-1000": {
      "property": "color / box-shadow",
      "selector": ".badge[data-tone='dark'], .badge[data-tone='light-outline']"
    },
    "--stroke-default": {
      "property": "box-shadow spread radius",
      "selector": ".badge[data-tone='dark-outline'], .badge[data-tone='light-outline']"
    }
  },

  "accessibility": {
    "role": "implicit (span)",
    "wcagLevel": "AA",
    "tapTargetMin": 0,
    "keyboardNav": [],
    "ariaPattern": "label",
    "notes": "Badge is a visual label (non-interactive — tapTargetMin=0). If it conveys state not present in adjacent text (e.g. 'OUT OF STOCK' on an otherwise normal-looking product), ensure the state is also encoded in markup — e.g. aria-label on the parent product element."
  },

  "dependencies": {
    "runtime": ["react"],
    "peer": [],
    "devOnly": []
  },

  "usageRef": "./usage.md",
  "examples": [
    "./examples.tsx#SaleBadge",
    "./examples.tsx#NewBadge",
    "./examples.tsx#DiscountBadge",
    "./examples.tsx#OutOfStockBadge",
    "./examples.tsx#LimitedBadge",
    "./examples.tsx#BestsellerBadge",
    "./examples.tsx#AllColorsRow",
    "./examples.tsx#AllEmphasisRow"
  ]
}
