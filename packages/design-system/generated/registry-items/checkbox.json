    "tokenBindings": {
      "--background-primary": {
        "property": "background",
        "selector": ".root::before"
      },
      "--surface-secondary": {
        "property": "background",
        "selector": ".root:hover:not([data-disabled])::before"
      },
      "--text-primary": {
        "property": "background/border-color",
        "selector": ".root[data-checked]::before, .root[data-indeterminate]::before"
      },
      "--border-default": {
        "property": "border-color",
        "selector": ".root::before"
      },
      "--fill-disabled": {
        "property": "background/border-color",
        "selector": ".root[data-disabled]::before"
      },
      "--border-focus": {
        "property": "outline-color",
        "selector": ".root:focus-visible"
      },
      "--radius-tag-primary": {
        "property": "border-radius",
        "selector": ".root::before"
      }
    }
  },
