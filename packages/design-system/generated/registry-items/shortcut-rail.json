    "rules": [
      "elevation-on-press",
      "focus-style",
      "no-custom-radii",
      "tap-target"
    ],
    "tokenBindings": {
      "--surface-primary": {
        "property": "background and edge gradient",
        "selector": ".root, .mask, and titled .iconSurface"
      },
      "--surface-secondary": {
        "property": "background",
        "selector": ".iconSurface, .root[data-has-title='true'] and its edge mask"
      },
      "--radius-full": {
        "property": "border-radius",
        "selector": ".iconSurface"
      },
      "--radius-surface-default": {
        "property": "border-radius",
        "selector": ".root[data-surface='card']"
      },
      "--font-size-caption-md": {
        "property": "font-size",
        "selector": ".label at or above 1024px"
      },
      "--font-size-caption-sm": {
        "property": "font-size",
        "selector": ".label below 1024px"
      },
      "--line-height-caption-md": {
        "property": "line-height",
        "selector": ".label at or above 1024px"
      },
      "--line-height-caption-sm": {
        "property": "line-height",
        "selector": ".label below 1024px"
      },
      "--layout-page-margin-default": {
        "property": "padding-inline and scroll-padding-inline",
        "selector": ".list below 1024px"
      },
      "--layout-page-margin-card": {
        "property": "width and max-width inset",
        "selector": ".root[data-surface='card']"
      },
      "--space-1000": {
        "property": "width / height",
        "selector": ".iconSurface"
      },
      "--space-600": {
        "property": "padding-inline and scroll-padding-inline",
        "selector": ".list, .edgePrevious, .edgeNext at or above 1024px"
      }
    }
  },
  "quality": {
    "accessibility": {
      "role": "labelled navigation containing a list of shortcut links",
      "wcagLevel": "AA",
      "tapTargetMin": 44,
      "keyboardNav": [
        "tab",
        "shift+tab",
        "enter"
      ],
      "ariaPattern": "nav with list/listitem links, optional visible title, and optional previous/next buttons",
      "structure": "A supplied title labels the navigation region; otherwise ariaLabel is used. Visible labels provide link names and decorative icon images use empty alt text.",
      "interaction": "Mobile uses native horizontal scrolling without paging chrome. Desktop adds overflow-aware paging controls over functional edge masks."
    },
    "interactionCoverage": "covered"
  },
