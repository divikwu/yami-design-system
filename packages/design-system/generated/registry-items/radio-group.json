    "tokenBindings": {
      "--background-primary": {
        "property": "background",
        "selector": ".item::before"
      },
      "--surface-secondary": {
        "property": "background",
        "selector": ".item:hover:not([data-disabled])::before"
      },
      "--text-primary": {
        "property": "border-color/background",
        "selector": ".item[data-checked]::before, .dot"
      },
      "--border-default": {
        "property": "border-color",
        "selector": ".item::before"
      },
      "--fill-disabled": {
        "property": "border-color/background",
        "selector": ".item[data-disabled]::before, .item[data-disabled] .dot"
      },
      "--border-focus": {
        "property": "outline-color",
        "selector": ".item:focus-visible"
      },
      "--radius-button-primary": {
        "property": "border-radius",
        "selector": ".item::before, .dot"
      }
    }
  },
  "quality": {
