  "design": {
    "tokens": [
      "--background-secondary",
      "--border-default",
      "--border-focus",
      "--button-primary",
      "--button-primary-active",
      "--button-secondary",
      "--button-secondary-active",
      "--button-tertiary-active",
      "--color-black-400",
      "--divider-emphasis",
      "--divider-subtle",
      "--fill-secondary",
      "--font-family-ios",
      "--font-size-body-md",
      "--font-size-caption-sm",
      "--font-size-heading-sm",
      "--font-size-link-md",
      "--font-size-link-sm",
      "--font-weight-emphasize",
      "--font-weight-normal",
      "--line-height-body-md",
      "--line-height-caption-sm",
      "--line-height-heading-sm",
      "--line-height-link-md",
      "--line-height-link-sm",
      "--radius-button-primary",
      "--radius-component-default",
      "--radius-full",
      "--radius-xl",
      "--space-025",
      "--space-050",
      "--space-100",
      "--space-150",
      "--space-200",
      "--space-300",
      "--space-400",
      "--space-600",
      "--stroke-default",
      "--stroke-thick",
      "--surface-primary",
      "--text-emphasis",
      "--text-primary",
      "--text-primary-inverse",
      "--text-secondary"
    ],
    "rules": [
      "border-strength",
      "elevation-on-press",
      "focus-style",
      "no-custom-radii",
      "no-opacity-disabled",
      "numerals-font",
      "red-usage",
      "semantic-color-only",
      "tap-target",
      "type-hierarchy"
    ],
    "tokenBindings": {
      "--surface-primary": {
        "property": "background",
        "selector": ".root fallback, .search, .railControl"
      },
      "--space-600": {
        "property": "padding-inline / left / right",
        "selector": ".utilityRow, .rail, .railControl edge inset"
      },
      "--divider-emphasis": {
        "property": "background",
        "selector": ".root::after viewport-wide closing rule at --stroke-thick"
      },
      "--border-default": {
        "property": "background / border-color",
        "selector": ".utilityRow::after row rule, .cart, .railControl"
      },
      "--border-focus": {
        "property": "border-color",
        "selector": ".search ring at --stroke-thick; outline-color on every focusable slot"
      },
      "--divider-subtle": {
        "property": "background",
        "selector": ".hallDivider, .railGroupDivider"
      },
      "--radius-button-primary": {
        "property": "border-radius",
        "selector": ".search, .searchSubmit, .zipcode, .account, .locale, .cart, .railControl"
      },
      "--radius-component-default": {
        "property": "border-radius",
        "selector": ".brand, .category, .hallButton"
      },
      "--button-primary": {
        "property": "background",
        "selector": ".searchSubmit"
      },
      "--text-emphasis": {
        "property": "color",
        "selector": ".categoryBadge"
      },
      "--font-size-caption-sm": {
        "property": "font-size",
        "selector": ".categoryLabel, .categoryBadge"
      },
      "--font-size-link-md": {
        "property": "font-size",
        "selector": ".hallButton, .zipcode, .account"
      },
      "--font-weight-emphasize": {
        "property": "font-weight",
        "selector": ".hallButton[data-selected], .categoryBadge"
      }
    }
  },
  "quality": {
    "accessibility": {
      "role": "banner landmark containing a search landmark and a category navigation region",
      "wcagLevel": "AA",
      "tapTargetMin": 44,
      "keyboardNav": [
