  "quality": {
    "accessibility": {
      "role": "contentinfo landmark containing labelled link lists and a newsletter form",
      "wcagLevel": "AA",
      "tapTargetMin": 44,
      "keyboardNav": [
        "tab",
        "shift+tab",
        "enter"
      ],
      "ariaPattern": "footer contentinfo + h3-titled link lists + a form with a visually hidden label; social, legal, and payment lists each carry an accessible name",
      "structure": "Group titles are real h3 headings so the footer is navigable by heading. Social glyphs are decorative (empty alt) and their anchors name themselves via aria-label. Payment marks carry the scheme name as alt because no visible label repeats it. Legal entries may override their accessible name via ariaLabel where the visible label under-describes the target.",
      "interaction": "The newsletter field reports rejection through aria-invalid plus an aria-describedby error node with role=alert; validation itself is the caller's. Destinations are optional throughout — an entry without href renders as a plain unlinked label, matching Header, so an unconfigured footer exposes no empty links.",
      "notes": "PC only. The footer has a 1024px minimum width. At 1920px the masthead is 50/50 with four link columns; at 1440px it is 50/50 with a two-by-two link grid; at 1024px the link panel is full width above two side-by-side right bands. Below 1024px the page scrolls horizontally; the mobile footer is a separate component."
    },
    "interactionCoverage": "covered"
  },
