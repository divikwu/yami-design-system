      "--divider-default": {
        "property": "background",
        "selector": ".masthead and .sidePanel structural gaps"
      },
      "--divider-emphasis": {
        "property": "border-top-color",
        "selector": ".root default top rule at --stroke-thick"
      },
      "--border-default": {
        "property": "border-color",
        "selector": ".subscribeInput"
      },
      "--border-focus": {
        "property": "border-color",
        "selector": ".subscribeInput:focus-visible"
      },
      "--space-600": {
        "property": "padding",
        "selector": ".linkPanel, .keepInTouch, .appBand, .closingBar inline"
      },
      "--space-800": {
        "property": "padding",
        "selector": ".closingBar block and 1024px inline"
      },
      "--space-400": {
        "property": "padding-block / margin-top",
        "selector": ".keepInTouch, .appBand, .appRow, .group + .group"
      },
      "--radius-component-default": {
        "property": "border-radius",
        "selector": ".subscribeInput, .subscribeSubmit, .appButton, .socialLink"
      },
      "--text-emphasis": {
        "property": "color",
        "selector": ".subscribeSubmit"
      },
      "--text-secondary": {
        "property": "color",
        "selector": ".groupLink"
      },
      "--text-secondary-inverse": {
        "property": "color",
        "selector": ".closingBar, .copyright, .legalLink"
      },
