      "--text-secondary": {
        "property": "color",
        "selector": ".trigger"
      },
      "--text-primary-inverse": {
        "property": "color",
        "selector": ".list[data-inverse='true'][data-variant='primary'][data-style='a'] .trigger[data-state='active'], .list[data-inverse='true'][data-variant='secondary'] .trigger[data-state='active'], .list[data-variant='tertiary']:not([data-inverse='true']) .trigger[data-state='active']"
      },
      "--text-disabled": {
        "property": "color",
        "selector": ".trigger[aria-disabled='true']"
      },
      "--surface-secondary": {
        "property": "background",
        "selector": ".list[data-variant='primary'][data-style='b']"
      },
      "--surface-primary": {
        "property": "background",
        "selector": ".list[data-variant='primary'][data-style='b'] .trigger[data-state='active']::before"
      },
      "--button-secondary": {
        "property": "background",
        "selector": ".list[data-variant='tertiary'] .trigger[data-state='inactive']:hover::before"
      },
      "--button-secondary-inverse": {
        "property": "background",
        "selector": ".list[data-inverse='true'][data-variant='tertiary'] .trigger[data-state='inactive']:hover::before"
      },
