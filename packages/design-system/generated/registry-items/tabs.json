        "selector": ".list[data-variant='tertiary']"
      },
      "--fill-skeleton": {
        "property": "background",
        "selector": ".skeletonItem"
      },
      "--border-focus": {
        "property": "outline-color",
        "selector": ".trigger:focus-visible, .content:focus-visible"
      },
      "--radius-full": {
        "property": "border-radius",
        "selector": ".trigger, .list[data-variant='primary'][data-style='b'], .skeletonItem"
      },
      "--font-family-ios": {
        "property": "font-family",
        "selector": ".root"
      }
