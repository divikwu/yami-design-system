      },
      "--radius-surface-default": {
        "property": "border-radius",
        "selector": ".card"
      },
      "--space-150": {
        "property": "padding",
        "selector": ".pad-sm"
      },
      "--space-200": {
        "property": "padding",
        "selector": ".pad-md"
      },
      "--space-300": {
        "property": "padding",
        "selector": ".pad-lg"
      }
    }
