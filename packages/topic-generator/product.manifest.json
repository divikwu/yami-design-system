    "topicPageVisualAgentOutput": "topic-page-visual-agent-output/v1",
    "topicPageVisualRun": "topic-page-visual-run/v1",
    "topicPageAssetManifest": "topic-page-asset-manifest/v1",
    "topicPageAgentRequest": "topic-page-agent-request/v1",
    "topicPageAgentResponse": "topic-page-agent-response/v1",
    "topicPageAutomationRun": "topic-page-automation-run/v1",
    "topicPageGenerationSpec": "topic-page-generation-spec/v1",
    "topicPageQaReport": "topic-page-qa-report/v1",
    "topicPageExperienceReviewProposal": "topic-page-experience-review-proposal/v1",
