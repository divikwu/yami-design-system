{
  "schemaVersion": "topic-generator-product/v1",
  "id": "topic-generator",
  "displayName": "TOPIC GENERATOR",
  "version": "0.3.0",
  "status": "workspace-product",
  "distribution": "private-workspace",
  "runtime": {
    "node": "~24",
    "packageManager": "pnpm@11.20.0"
  },
  "entrypoints": {
    "web": "/",
    "api": "/api/topic-generator",
    "cli": "topic-generator",
    "evaluationCli": "topic-intent-eval",
    "package": "@yami/topic-generator",
    "webHostPackage": "@yami/topic-generator-app"
  },
  "integrations": {
    "codexSkill": "integrations/codex/topic-intent/SKILL.md",
    "codexSkills": [
      "integrations/codex/topic-intent/SKILL.md",
      "integrations/codex/product-selection/SKILL.md"
    ],
    "kiroAgent": "integrations/kiro/topic-generator.json",
    "productAgentModes": {
      "current": ["codex-skill", "kiro-skill"],
      "future": ["http-adapter"]
    }
  },
  "providers": [
    {
      "id": "yami-catalog-search",
      "authentication": "none",
      "fallback": "yami-web-search"
    },
    {
      "id": "yami-web-search",
      "authentication": "none",
      "fallback": null
    }
  ],
  "contracts": {
    "semanticProposal": "semantic-proposal/v1",
    "themeIntent": "theme-intent/v2",
    "catalogSnapshot": "catalog-snapshot/v1",
    "catalogTaxonomySnapshot": "catalog-taxonomy-snapshot/v1",
    "categoryRoleProposal": "category-role-proposal/v1",
    "catalogCandidateSnapshot": "catalog-candidate-snapshot/v1",
    "catalogCandidateQualityReport": "catalog-candidate-quality-report/v1",
    "sceneProposal": "scene-proposal/v1",
    "productSelectionRun": "product-selection-run/v1",
    "productSelectionResult": "product-selection-result/v1",
    "productSelectionGoldenEvaluation": "product-selection-golden-evaluation/v1",
    "productSelectionHandoffTask": "product-selection-handoff-task/v1",
    "productSelectionHandoffResponse": "product-selection-handoff-response/v1",
    "pagePlans": "page-plans/v1",
    "runArtifact": "topic-generator-run/v1"
  },
  "documents": {
    "readme": "README.md",
    "architecture": "docs/architecture.md",
    "core": "docs/core.md"
  },
  "standaloneReadiness": {
    "core": "ready",
    "cli": "ready",
    "skill": "ready",
    "kiroAgent": "ready",
    "webSource": "ready",
    "webRuntime": "standalone-host",
    "archive": "not-built"
  }
}
