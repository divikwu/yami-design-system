  "integrations": {
    "codexSkill": "integrations/codex/topic-intent/SKILL.md",
    "codexSkills": [
      "integrations/codex/topic-intent/SKILL.md",
      "integrations/codex/background-evidence/SKILL.md",
      "integrations/codex/product-selection/SKILL.md",
      "integrations/codex/page-merchandising/SKILL.md",
      "integrations/codex/content-writing/SKILL.md",
      "integrations/codex/content-review/SKILL.md",
      "integrations/codex/visual-generation/SKILL.md",
      "integrations/codex/page-orchestration/SKILL.md",
      "integrations/codex/page-review/SKILL.md"
    ],
    "kiroAgent": "integrations/kiro/topic-page-orchestrator.json",
    "kiroAgents": [
      "integrations/kiro/topic-page-orchestrator.json",
      "integrations/kiro/topic-strategy.json",
      "integrations/kiro/topic-background-evidence.json",
      "integrations/kiro/topic-content.json",
      "integrations/kiro/topic-content-review.json",
      "integrations/kiro/topic-visual.json",
      "integrations/kiro/topic-review.json"
