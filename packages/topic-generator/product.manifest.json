    "core": "ready",
    "cli": "ready",
    "skill": "ready",
    "kiroAgent": "ready",
    "orchestratorAgent": "ready",
    "strategyAgent": "ready",
    "backgroundEvidenceAgent": "host-web-research-capability-required",
    "contentAgent": "ready",
    "contentReviewAgent": "ready",
    "visualAgent": "generator-adapter-required",
    "reviewAgent": "preview-inspection-adapter-required",
    "webSource": "ready",
    "webRuntime": "standalone-automation-host",
    "pageAutomation": "agent-and-asset-store-configuration-required",
    "archive": "not-built"
