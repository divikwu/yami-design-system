{
  "ci": {
    "collect": {
      "startServerCommand": "YAMI_SITE_PASSWORD=yami-local-preview-only YAMI_SESSION_SECRET=local-preview-session-secret-not-for-production-2026 VERCEL= pnpm start",
      "puppeteerScript": "./scripts/lighthouse-login.cjs",
      "puppeteerLaunchOptions": { "args": ["--no-sandbox", "--disable-dev-shm-usage"] },
      "startServerReadyPattern": "Ready|started server",
      "startServerReadyTimeout": 120000,
      "url": [
        "http://127.0.0.1:3400/zh",
        "http://127.0.0.1:3400/en/docs/getting-started",
        "http://127.0.0.1:3400/zh/blog/build-test-document-components-with-storybook"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "disableStorageReset": true
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.95 }],
        "is-crawlable": ["error", { "minScore": 0, "maxScore": 0 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
