{
  "name": "@yami/docsite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "pnpm check:content && next build",
    "start": "next start -p 3400",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.config.ts",
    "test:lighthouse": "lhci autorun --config=lighthouserc.json",
    "check:content": "node scripts/check-content.mjs",
    "generate:blog-covers": "node scripts/generate-blog-covers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@hugeicons/core-free-icons": "4.3.0",
    "@hugeicons/react": "1.1.10",
    "@yami/design-system": "workspace:*",
    "gray-matter": "4.0.3",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "playwright": "1.62.1",
    "playwright-core": "1.61.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
