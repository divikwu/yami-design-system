TOPIC_AGENT_RUNNER_HOST=127.0.0.1
TOPIC_AGENT_RUNNER_PORT=4400
TOPIC_AGENT_RUNNER_EXECUTOR=codex

# Leave empty only while the service is bound to localhost. When set, configure the same
# value in TOPIC_GENERATOR_AGENT_TOKEN and TOPIC_GENERATOR_PAGE_AGENT_TOKEN.
TOPIC_AGENT_RUNNER_TOKEN=

TOPIC_AGENT_RUNNER_TIMEOUT_MS=300000
TOPIC_AGENT_RUNNER_MAX_REQUEST_BYTES=2097152
TOPIC_AGENT_RUNNER_MAX_OUTPUT_BYTES=4194304
TOPIC_AGENT_RUNNER_MAX_IMAGE_BYTES=26214400
# Native ImageGen tasks run independently while preserving proposal order. Keep between 1 and 4;
# the default of 3 reduces queue time while retaining one slot of headroom.
TOPIC_AGENT_RUNNER_IMAGE_CONCURRENCY=3
TOPIC_AGENT_RUNNER_IMAGE_ATTEMPT_TIMEOUT_MS=300000
# Defaults to <repository>/.topic-generator/image-cache when empty.
TOPIC_AGENT_RUNNER_IMAGE_CACHE_ROOT=
TOPIC_AGENT_RUNNER_PREVIEW_ORIGIN=http://127.0.0.1:3300

TOPIC_AGENT_RUNNER_CODEX_COMMAND=codex
# This selects the Codex Agent, not the native image generator model.
TOPIC_AGENT_RUNNER_CODEX_MODEL=
TOPIC_AGENT_RUNNER_KIRO_COMMAND=kiro-cli
TOPIC_AGENT_RUNNER_KIRO_MODEL=

# Override only when the Runner is launched outside this monorepo.
TOPIC_AGENT_RUNNER_REPO_ROOT=
