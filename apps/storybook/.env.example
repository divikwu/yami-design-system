# Configure these in the Storybook Vercel project, for Production and Preview.
# Use the same password as Docsite (at least 8 characters).
YAMI_SITE_PASSWORD=
# Independent random secret per app, at least 32 characters. Never VITE_.
YAMI_SESSION_SECRET=
# Storybook's Vite dev server does not execute Vercel proxy.ts.
# Use the protected preview command described in docs/deployment/site-password.md.
