{
  "name": "@yami/storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "node scripts/build-proxy.mjs && node --test scripts/proxy-bundle.test.mjs && storybook build",
    "preview:protected": "NODE_ENV=production tsx scripts/preview-protected.ts",
    "test-storybook": "vitest run --project=storybook --project=browser --exclude tests/ProductMediaGallery.browser.test.tsx && vitest run --project=browser tests/ProductMediaGallery.browser.test.tsx",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@vercel/functions": "3.9.5",
    "@yami/design-system": "workspace:*",
    "@yami/prototypes": "workspace:*",
    "@yami/site-access": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-vitest": "10.5.10",
    "@storybook/react-vite": "10.5.10",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "esbuild": "0.28.2",
    "storybook": "10.5.10",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
