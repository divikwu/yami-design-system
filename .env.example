NEXT_PUBLIC_PREVIEW_ORIGIN=http://localhost:3200

# Optional HTTP Agent automation for the standalone Web Host. Point both endpoints at the local
# Topic Generator Agent Runner when automatic ProductSelection and page generation are required.
TOPIC_GENERATOR_TAXONOMY_PATH=
TOPIC_GENERATOR_TAXONOMY_SOURCE_REF=
TOPIC_GENERATOR_AGENT_ENDPOINT=
TOPIC_GENERATOR_AGENT_ID=topic-product-agent
TOPIC_GENERATOR_AGENT_TOKEN=
TOPIC_GENERATOR_AGENT_TIMEOUT_MS=330000
TOPIC_GENERATOR_PAGE_AGENT_ENDPOINT=
TOPIC_GENERATOR_PAGE_AGENT_ID=topic-page-agent
TOPIC_GENERATOR_TOPIC_INTENT_AGENT_ID=topic-strategy
TOPIC_GENERATOR_ORCHESTRATOR_AGENT_ID=topic-page-orchestrator
TOPIC_GENERATOR_STRATEGY_AGENT_ID=topic-strategy
TOPIC_GENERATOR_CONTENT_AGENT_ID=topic-content
TOPIC_GENERATOR_VISUAL_AGENT_ID=topic-visual
# Defaults to generated-images. source-product-images is a draft-only catalog-reference fallback
# and is intentionally rejected by final visual QA.
TOPIC_GENERATOR_VISUAL_PRODUCTION_MODE=generated-images
TOPIC_GENERATOR_REVIEW_AGENT_ID=topic-review
TOPIC_GENERATOR_PAGE_AGENT_TOKEN=
TOPIC_GENERATOR_PAGE_AGENT_TIMEOUT_MS=330000
TOPIC_GENERATOR_ASSET_ROOT=
TOPIC_GENERATOR_PREVIEW_ORIGIN=http://127.0.0.1:3300
# Optional in development (defaults to <workspace>/.topic-generator/runs). Required in
# production and must be an absolute path on persistent local or mounted storage.
TOPIC_GENERATOR_RUN_ROOT=

# Optional local Agent Runner. The runner binds to localhost by default and can use the
# authenticated Codex or Kiro CLI without exposing provider credentials to the browser.
TOPIC_AGENT_RUNNER_HOST=127.0.0.1
TOPIC_AGENT_RUNNER_PORT=4400
TOPIC_AGENT_RUNNER_EXECUTOR=codex
TOPIC_AGENT_RUNNER_TOKEN=
TOPIC_AGENT_RUNNER_TIMEOUT_MS=300000
TOPIC_AGENT_RUNNER_PREVIEW_ORIGIN=http://127.0.0.1:3300
TOPIC_AGENT_RUNNER_MAX_REQUEST_BYTES=2097152
TOPIC_AGENT_RUNNER_MAX_OUTPUT_BYTES=4194304
TOPIC_AGENT_RUNNER_MAX_IMAGE_BYTES=26214400
TOPIC_AGENT_RUNNER_IMAGE_CONCURRENCY=2
TOPIC_AGENT_RUNNER_CODEX_COMMAND=codex
TOPIC_AGENT_RUNNER_CODEX_MODEL=
TOPIC_AGENT_RUNNER_KIRO_COMMAND=kiro-cli
TOPIC_AGENT_RUNNER_KIRO_MODEL=
